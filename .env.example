# Copy to .env.local and fill in. NEVER commit real values.

# Clerk (authentication only)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase (server-side only; the browser never talks to Supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role: seed script, first-login link and email worker ONLY
SUPABASE_SERVICE_ROLE_KEY=

# App-layer encryption key for Aadhaar (32 random bytes, base64)
AADHAAR_ENCRYPTION_KEY=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# AI agent
AGENT_MODEL=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
