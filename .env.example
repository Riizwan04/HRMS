# Copy to .env.local and fill in. NEVER commit real values.

# Clerk (authentication only)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Neon Postgres. The browser never sees these.
# Runtime role (app_runtime): the ONLY database URL allowed in Vercel's environment.
DATABASE_URL=
# Owner/admin role: migrations and seed ONLY. Never set this on Vercel.
DATABASE_URL_ADMIN=

# Vercel Blob (private store for medical certificates), server only
BLOB_READ_WRITE_TOKEN=

# App-layer encryption key for Aadhaar (32 random bytes, base64)
AADHAAR_ENCRYPTION_KEY=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# AI agent
AGENT_MODEL=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
